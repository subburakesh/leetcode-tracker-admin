{
  "name": "leetcode-tracker-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "seed:admin": "npm run seed:admin --prefix server",
    "build": "npm run build --prefix client",
    "postinstall": "npm install --prefix server && npm install --prefix client"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "body-parser": "^2.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
